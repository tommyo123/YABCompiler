10 DIM A$(10)
20 FOR I=1 TO 5
30 READ A$(I)
40 NEXT
50 DATA "APPLE","BANANA","CHERRY","DATE","ELDERBERRY"
60 FOR I=1 TO 5
70 PRINT I;A$(I);LEN(A$(I))
80 NEXT
90 N=5
100 FOR I=1 TO N-1
110 FOR J=1 TO N-I
120 IF A$(J)<=A$(J+1) THEN 160
130 T$=A$(J)
140 A$(J)=A$(J+1)
150 A$(J+1)=T$
160 NEXT J
170 NEXT I
180 PRINT "SORTED:"
190 FOR I=1 TO N
200 PRINT A$(I)
210 NEXT
