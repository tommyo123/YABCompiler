10 DIM A(20),B(20),C(20)
20 FOR I=1 TO 20
30 A(I)=I
40 B(I)=I*I
50 C(I)=A(I)+B(I)
60 NEXT
70 FOR I=1 TO 20
80 PRINT A(I);
90 NEXT:PRINT
100 FOR I=1 TO 20
110 PRINT B(I);
120 NEXT:PRINT
130 FOR I=1 TO 20
140 PRINT C(I);
150 NEXT:PRINT
160 SA=0:SB=0:SC=0
170 FOR I=1 TO 20
180 SA=SA+A(I):SB=SB+B(I):SC=SC+C(I)
190 NEXT
200 PRINT SA;SB;SC
210 PRINT SA+SB-SC
