10 A$="HELLO"
20 SH=3
30 R$=""
40 FOR I=1 TO LEN(A$)
50 C=ASC(MID$(A$,I,1))
60 IF C>=65 AND C<=90 THEN C=C+SH:IF C>90 THEN C=C-26
70 R$=R$+CHR$(C)
80 NEXT
90 PRINT A$
100 PRINT R$
110 D$=""
120 FOR I=1 TO LEN(R$)
130 C=ASC(MID$(R$,I,1))
140 IF C>=65 AND C<=90 THEN C=C-SH:IF C<65 THEN C=C+26
150 D$=D$+CHR$(C)
160 NEXT
170 PRINT D$
180 IF D$=A$ THEN PRINT "OK"
