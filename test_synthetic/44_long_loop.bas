1 REM SETTLE=20
10 PRINT "COUNT TO 1000:"
20 N=0
30 FOR I=1 TO 1000
40 N=N+1
50 NEXT
60 PRINT N
70 S=0
80 FOR I=1 TO 100
90 FOR J=1 TO 10
100 S=S+1
110 NEXT J,I
120 PRINT S
130 P=1
140 FOR I=1 TO 12
150 P=P*2
160 NEXT
170 PRINT "2^12=";P
180 H=0
190 FOR I=1 TO 100
200 H=H+1/I
210 NEXT
220 PRINT INT(H*1000)
