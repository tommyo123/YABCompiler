10 A$="ALPHA,BETA,GAMMA,DELTA"
20 P=1:N=0
30 FOR I=1 TO LEN(A$)
40 IF MID$(A$,I,1)="," THEN PRINT MID$(A$,P,I-P);"|";:P=I+1:N=N+1
50 NEXT
60 PRINT MID$(A$,P)
70 PRINT "PARTS:";N+1
80 B$="HELLO"
90 R$=""
100 FOR I=LEN(B$) TO 1 STEP -1
110 R$=R$+MID$(B$,I,1)
120 NEXT
130 PRINT R$
140 IF B$=R$ THEN PRINT "PALINDROME"
150 IF B$<>R$ THEN PRINT "NOT PAL"
