10 A$="HELLO"
20 B$="WORLD"
30 PRINT A$+" "+B$
40 PRINT LEN(A$);LEN(B$);LEN(A$+B$)
50 PRINT LEFT$(A$,3);" ";RIGHT$(A$,2);" ";MID$(A$,2,3)
60 C$=""
70 FOR I=1 TO 5
80 C$=C$+CHR$(64+I)
90 NEXT
100 PRINT C$
110 PRINT ASC("A");ASC("Z");ASC(" ")
120 PRINT CHR$(65);CHR$(66);CHR$(67)
130 PRINT VAL("123");VAL("3.14");VAL("ABC")
140 PRINT STR$(42);STR$(-7);STR$(3.14)
