10 DIM A(4,4),B(4,4),C(4,4)
20 FOR I=1 TO 4
30 FOR J=1 TO 4
40 A(I,J)=I+J
50 B(I,J)=I*J
60 NEXT J,I
70 PRINT "A:"
80 FOR I=1 TO 4
90 FOR J=1 TO 4
100 PRINT A(I,J);
110 NEXT J:PRINT
120 NEXT I
130 PRINT "B:"
140 FOR I=1 TO 4
150 FOR J=1 TO 4
160 PRINT B(I,J);
170 NEXT J:PRINT
180 NEXT I
190 FOR I=1 TO 4
200 FOR J=1 TO 4
210 C(I,J)=A(I,J)+B(I,J)
220 NEXT J,I
230 PRINT "A+B:"
240 FOR I=1 TO 4
250 FOR J=1 TO 4
260 PRINT C(I,J);
270 NEXT J:PRINT
280 NEXT I
