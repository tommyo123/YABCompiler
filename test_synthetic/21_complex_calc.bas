1 REM SETTLE=10
10 PRINT "PRIMES TO 30:"
20 FOR N=2 TO 30
30 P=1
40 FOR D=2 TO N-1
50 IF N/D=INT(N/D) THEN P=0
60 NEXT
70 IF P=1 THEN PRINT N;
80 NEXT
90 PRINT
100 PRINT "POWERS OF 2:"
110 V=1
120 FOR I=1 TO 10
130 V=V*2
140 PRINT V;
150 NEXT
160 PRINT
170 S=0
180 FOR I=1 TO 100
190 S=S+I*I
200 NEXT
210 PRINT "SUM OF SQUARES TO 100:";S
