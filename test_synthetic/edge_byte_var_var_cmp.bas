10 REM Byte var-var compare: IF C<D with both byte-storage
20 REM Should emit LDA/CMP/BCS not the 16-bit SBC chain.
30 W=1024
40 POKE W,5:POKE W+1,3
50 C=PEEK(W):D=PEEK(W+1)
60 IF C<D THEN PRINT"C<D":GOTO80
70 PRINT"C>=D"
80 POKE W,3:POKE W+1,5
90 C=PEEK(W):D=PEEK(W+1)
95 IF C<D THEN PRINT"C<D NOW":GOTO110
100 PRINT"C>=D NOW"
110 IF C=D THEN PRINT"EQUAL"
120 IF C<>D THEN PRINT"NOT EQUAL"
