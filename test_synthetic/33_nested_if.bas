10 FOR I=-2 TO 2
20 IF I<0 THEN PRINT I;"NEG":GOTO 60
30 IF I=0 THEN PRINT I;"ZERO":GOTO 60
40 IF I>0 AND I<2 THEN PRINT I;"POSSMALL":GOTO 60
50 PRINT I;"POSBIG"
60 NEXT
70 A=5:B=10
80 IF A<B THEN IF A>0 THEN PRINT "BOTH"
90 IF A=B THEN PRINT "FAIL" : GOTO 110
100 PRINT "OK"
110 IF A>0 AND B>0 AND A<B THEN PRINT "ALL"
120 IF NOT(A=B) AND A<>0 THEN PRINT "NOTEQ"
