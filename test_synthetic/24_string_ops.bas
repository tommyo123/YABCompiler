10 A$="HELLO"
20 B$="WORLD"
30 C$=A$+" "+B$+"!"
40 PRINT C$
50 PRINT LEN(C$)
60 D$=""
70 FOR I=1 TO LEN(C$)
80 IF MID$(C$,I,1)<>" " THEN D$=D$+MID$(C$,I,1)
90 NEXT
100 PRINT D$
110 E$=LEFT$(C$,5)+"..."+RIGHT$(C$,5)
120 PRINT E$
130 F$=A$
140 FOR I=1 TO 3
150 F$=F$+A$
160 NEXT
170 PRINT F$
180 PRINT LEN(F$)
190 G$=A$
200 FOR I=2 TO 5
210 IF MID$(G$,I,1)<MID$(G$,I-1,1) THEN PRINT "FOUND";I
220 NEXT
