10 N=5
20 DIM K$(N),V(N)
30 DATA "ALPHA",1,"BETA",2,"GAMMA",3,"DELTA",4,"EPSILON",5
40 FOR I=1 TO N
50 READ K$(I),V(I)
60 NEXT
70 Q$="GAMMA"
80 FOR I=1 TO N
90 IF K$(I)=Q$ THEN PRINT Q$;"=";V(I):GOTO 110
100 NEXT
110 Q$="ZETA"
120 F=0
130 FOR I=1 TO N
140 IF K$(I)=Q$ THEN F=1:PRINT "FOUND";V(I)
150 NEXT
160 IF F=0 THEN PRINT Q$;" NOT FOUND"
170 PRINT "ALL KEYS:"
180 FOR I=1 TO N
190 PRINT K$(I);"=";V(I)
200 NEXT
