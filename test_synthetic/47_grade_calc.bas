10 N=10
20 DIM SC(N)
30 DATA 85,72,90,55,68,95,40,77,82,60
40 FOR I=1 TO N
50 READ SC(I)
60 NEXT
70 T=0
80 FOR I=1 TO N
90 T=T+SC(I)
100 NEXT
110 AV=T/N
120 PRINT "AVG:";AV
130 P=0:F=0
140 FOR I=1 TO N
150 IF SC(I)>=60 THEN P=P+1
160 IF SC(I)<60 THEN F=F+1
170 NEXT
180 PRINT "PASS:";P,"FAIL:";F
190 BS=SC(1):WS=SC(1)
200 FOR I=2 TO N
210 IF SC(I)>BS THEN BS=SC(I)
220 IF SC(I)<WS THEN WS=SC(I)
230 NEXT
240 PRINT "BEST:";BS,"WORST:";WS
