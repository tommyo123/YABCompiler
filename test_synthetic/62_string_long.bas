10 A$="012345678901234567890123456789"
20 PRINT LEN(A$)
30 PRINT A$
40 B$=A$+A$
50 PRINT LEN(B$)
60 PRINT MID$(B$,30,10)
70 PRINT LEFT$(B$,10);"|";RIGHT$(B$,10)
80 C$=""
90 FOR I=1 TO 20
100 C$=C$+CHR$(64+(I AND 15)+1)
110 NEXT
120 PRINT C$
130 PRINT LEN(C$)
140 D$=""
150 FOR I=1 TO LEN(C$) STEP 2
160 D$=D$+MID$(C$,I,1)
170 NEXT
180 PRINT D$
