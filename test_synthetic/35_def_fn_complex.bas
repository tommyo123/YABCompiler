10 DEF FN A(X)=X*2+1
20 DEF FN B(X)=X*X-X
30 DEF FN C(X)=ABS(X)+1
40 PRINT FN A(1);FN A(5);FN A(10)
50 PRINT FN B(2);FN B(5);FN B(10)
60 PRINT FN C(-3);FN C(0);FN C(5)
70 FOR I=1 TO 5
80 PRINT FN A(I);FN B(I);FN C(I-3)
90 NEXT
100 R=0
110 FOR I=1 TO 10
120 R=R+FN A(I)
130 NEXT
140 PRINT "SUM A(1..10):";R
