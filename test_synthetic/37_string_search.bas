10 A$="HELLO WORLD HELLO"
20 T$="HELLO"
30 N=0
40 FOR I=1 TO LEN(A$)-LEN(T$)+1
50 IF MID$(A$,I,LEN(T$))=T$ THEN N=N+1:PRINT "FOUND AT";I
60 NEXT
70 PRINT "TOTAL:";N
80 B$="ABCABCABC"
90 C$="ABC"
100 N=0
110 FOR I=1 TO LEN(B$)-LEN(C$)+1
120 IF MID$(B$,I,LEN(C$))=C$ THEN N=N+1
130 NEXT
140 PRINT "ABC IN ABCABCABC:";N
150 PRINT MID$(A$,7,5)
160 PRINT MID$(A$,1,5)
170 PRINT MID$(A$,LEN(A$)-4,5)
