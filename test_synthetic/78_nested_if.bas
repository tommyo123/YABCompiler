10 FOR X=1 TO 5
20 IF X<3 THEN IF X<2 THEN PRINT "A":GOTO 100
30 IF X<3 THEN PRINT "B":GOTO 100
40 IF X<5 THEN IF X<4 THEN PRINT "C":GOTO 100
50 IF X<5 THEN PRINT "D":GOTO 100
60 PRINT "E"
100 NEXT
110 FOR X=1 TO 4
120 IF X=1 THEN PRINT "ONE"
130 IF X=2 THEN PRINT "TWO"
140 IF X=3 THEN PRINT "THREE"
150 IF X=4 THEN PRINT "FOUR"
160 NEXT
170 PRINT "DONE"
