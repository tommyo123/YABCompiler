10 PX=7:PY=7:CN=0
20 DIM PF(PX,PY),FX(PX*PY*3),FY(PX*PY*3)
30 FOR X=0 TO PX:FOR Y=0 TO PY:PF(X,Y)=1:NEXT:NEXT
40 PF(3,3)=2:PF(4,4)=2:PF(0,5)=2
50 X=1:Y=1:CL=PF(X,Y):N=0:GOSUB 300
60 FOR Y=1 TO PY:FOR X=0 TO PX:PRINT PF(X,Y);:NEXT:PRINT:NEXT
70 PRINT "N=";N;"CN=";CN
80 END
300 IF CL=0 OR CL=15 THEN RETURN
310 FS=1:FX(FS)=X:FY(FS)=Y
320 FOR FS=1 TO 1 STEP -1
330 X=FX(FS):Y=FY(FS)
340 IF X<0 OR Y<1 OR X>PX OR Y>PY THEN NEXT:RETURN
350 PK=PF(X,Y)
360 IF PK>127 THEN NEXT:RETURN
370 IF PK=2 THEN GOSUB 500
380 IF PK<>CL THEN NEXT:RETURN
390 PF(X,Y)=PK+128
400 N=N+1
410 FS=FS+1:FX(FS)=X+1:FY(FS)=Y
420 FS=FS+1:FX(FS)=X-1:FY(FS)=Y
430 FS=FS+1:FX(FS)=X:FY(FS)=Y+1
440 FS=FS+1:FX(FS)=X:FY(FS)=Y-1
450 FS=FS+1:NEXT
460 RETURN
500 CN=CN+1
510 RETURN
