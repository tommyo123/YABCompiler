10 REM INTEGER ARRAY BUBBLE SORT
20 REM INDEXED READS AND WRITES
30 REM CHECKS BOUNDARY ELEMENTS
40 DIM A%(20)
50 FOR I=0 TO 20:A%(I)=20-I:NEXT
60 FOR P=1 TO 20
70 FOR J=0 TO 19
80 IF A%(J)<=A%(J+1) THEN 120
90 T%=A%(J)
100 A%(J)=A%(J+1)
110 A%(J+1)=T%
120 NEXT J
130 NEXT P
140 FOR I=0 TO 20:PRINT A%(I);:NEXT
150 PRINT
160 END
