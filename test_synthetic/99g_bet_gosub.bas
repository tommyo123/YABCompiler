10 POKE53281,13
20 PRINT"PRESS SPACE TO START"
30 GET A$:IF A$<>" " THEN 30
40 PRINT"BET PROMPT (\): ";
50 OPEN 2,0:INPUT#2,AM$:CLOSE 2
60 PRINT"GOT AM$=[";AM$;"]"
70 HD=VAL(AM$)
80 PRINT"HD=";HD
90 BE=BE+HD
100 PRINT"BE=";BE
110 C=C+1
120 PRINT"C=";C
130 CA(C)=INT(RND(1)*52)+1
140 PRINT"CA(C)=";CA(C)
150 PRINT"CA(0)=";CA(0)
160 PRINT"CA(1)=";CA(1)
170 GOSUB 2000
180 PRINT"BACK FROM 2000, CW=";CW
190 END
2000 IF CA(C)<14 THEN CC=164:C1=0:TS=0:GOTO 2050
2010 IF CA(C)<27 THEN CC=98:C1=2:TS=13:GOTO 2050
2020 IF CA(C)<40 THEN CC=99:C1=2:TS=26:GOTO 2050
2030 IF CA(C)<53 THEN CC=161:C1=0:TS=39:GOTO 2050
2050 CW=CA(C)-TS
2060 PRINT"IN 2000: CW=";CW
2115 IF CW>13 THEN PRINT"ERROR":END
2120 RETURN
