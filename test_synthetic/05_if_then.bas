10 FOR I=1 TO 10
20 IF I=5 THEN PRINT "FIVE":GOTO 50
30 IF I<5 THEN PRINT "LOW";I:GOTO 50
40 PRINT "HIGH";I
50 NEXT
60 A=10:B=20
70 IF A<B THEN PRINT "A<B"
80 IF A>B THEN PRINT "A>B"
90 IF A=10 AND B=20 THEN PRINT "BOTH"
100 IF A=11 OR B=20 THEN PRINT "EITHER"
110 IF NOT(A=B) THEN PRINT "NOT EQUAL"
