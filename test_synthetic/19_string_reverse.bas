10 A$="HELLOWORLD"
20 B$=""
30 FOR I=LEN(A$) TO 1 STEP -1
40 B$=B$+MID$(A$,I,1)
50 NEXT
60 PRINT A$
70 PRINT B$
80 IF A$=B$ THEN PRINT "PALINDROME"
90 IF A$<>B$ THEN PRINT "NOT PALINDROME"
100 C$="LEVEL"
110 D$=""
120 FOR I=LEN(C$) TO 1 STEP -1
130 D$=D$+MID$(C$,I,1)
140 NEXT
150 PRINT C$,D$
160 IF C$=D$ THEN PRINT C$;" IS PAL"
