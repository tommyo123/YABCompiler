10 DIM A(20)
20 N=10
30 FOR I=1 TO N
40 A(I)=I*I-I+1
50 NEXT
60 S=0
70 FOR I=1 TO N
80 S=S+A(I)
90 NEXT
100 PRINT "SUM:";S
110 MX=A(1):MN=A(1)
120 FOR I=2 TO N
130 IF A(I)>MX THEN MX=A(I)
140 IF A(I)<MN THEN MN=A(I)
150 NEXT
160 PRINT "MAX:";MX,"MIN:";MN
170 FOR I=1 TO N
180 PRINT A(I);
190 NEXT
200 PRINT
210 DIM B(N)
220 FOR I=1 TO N
230 B(I)=A(N-I+1)
240 NEXT
250 FOR I=1 TO N
260 PRINT B(I);
270 NEXT
280 PRINT
